{
  "name": "frontend",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "prepare": "cd .. && git config core.hooksPath .husky || true"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.22",
    "i18next": "^26.5.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^17.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
