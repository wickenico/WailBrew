{
  "name": "frontend",
  "private": true,
  "version": "0.15.3",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:dev": "tsc && vite build --minify false --mode development",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "prepare": "cd .. && git config core.hooksPath .husky || true"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.28",
    "@wailsio/runtime": "3.1.0",
    "i18next": "^27.2.9",
    "i18next-browser-languagedetector": "^8.3.1",
    "lucide-react": "^1.80.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^18.0.3",
    "recharts": "^3.11.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "lint-staged": "^17.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
